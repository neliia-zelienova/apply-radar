# Copy to `.env` in this folder (apps/web/.env).

# Apply Radar API (apps/api), see PORT in apps/api/.env
VITE_API_URL=http://localhost:3010

# Same "Web application" OAuth client as the extension (Web client 2).
# In Google Cloud Console add this "Authorized redirect URI" (sign-in popup):
#   http://localhost:5173/oauth2
VITE_GOOGLE_OAUTH_CLIENT_ID=
