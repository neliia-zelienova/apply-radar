// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  previewFeatures = ["relationJoins", "driverAdapters", "queryCompiler"]
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  PENDING
  INTERVIEW
  OFFERED
  REJECTED
}

model Users {
  id             String   @id @default(uuid())
  oauthId        String   @unique @map("oauth_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  userApplications UserApplications[]

  @@map("users")
}

model Applications {
  id          String            @id @default(uuid())
  name        String
  description String            @default("")
  status      ApplicationStatus @default(PENDING)
  url         String
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  notes       String             @default("")
  archived    Boolean           @default(false)

  interviews       ApplicationInterviews[]
  userApplications UserApplications[]

  @@index([status])
  @@index([createdAt])
  @@map("applications")
}

model Interviews {
  id                    String   @id @default(uuid())
  notes                 String?
  scheduledAt           DateTime @map("scheduled_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  applicationInterviews ApplicationInterviews[]

  @@index([scheduledAt])
  @@map("interviews")
}

model ApplicationInterviews {
  applicationId String @map("application_id")
  interviewId   String @map("interview_id")

  application Applications @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interview   Interviews   @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@id([applicationId, interviewId])
  @@map("application_interviews")
}

model UserApplications {
  userId        String @map("user_id")
  applicationId String @map("application_id")

  user        Users        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Applications @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([userId, applicationId])
  @@map("user_applications")
}
