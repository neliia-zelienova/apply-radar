// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  previewFeatures = ["relationJoins", "driverAdapters", "queryCompiler"]
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  PENDING
  INTERVIEW
  OFFERED
  REJECTED
}

model Users {
  id             String   @id @default(uuid())
  oauthId        String   @unique @map("oauth_id")
  /// Avatar settings chosen in the apps: {source, icon, color, background}. No personal data.
  avatar         Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  userApplications UserApplications[]

  @@map("users")
}

model Applications {
  id          String            @id @default(uuid())
  name        String
  description String            @default("")
  status      ApplicationStatus @default(PENDING)
  url         String
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  notes       String             @default("")
  archived    Boolean           @default(false)
  /// Job title, e.g. "Front-end Engineer" (name holds the company).
  position    String            @default("")
  favorite    Boolean           @default(false)

  interviews       ApplicationInterviews[]
  userApplications UserApplications[]

  @@index([status])
  @@index([createdAt])
  @@map("applications")
}

model Interviews {
  id                    String   @id @default(uuid())
  notes                 String?
  scheduledAt           DateTime @map("scheduled_at")
  /// e.g. Screening, Technical, Onsite
  name                  String?
  /// Zoom/Meet/Maps/office link
  locationLink          String?  @map("location_link")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  applicationInterviews ApplicationInterviews[]

  @@index([scheduledAt])
  @@map("interviews")
}

model ApplicationInterviews {
  applicationId String @map("application_id")
  interviewId   String @map("interview_id")

  application Applications @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interview   Interviews   @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@id([applicationId, interviewId])
  @@map("application_interviews")
}

model UserApplications {
  userId        String @map("user_id")
  applicationId String @map("application_id")

  user        Users        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Applications @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([userId, applicationId])
  @@map("user_applications")
}

/// Public content pages of the web app (/about, /extension). Edited directly in
/// the DB (Neon SQL editor or Prisma Studio); the API caches them for ~60s.
model Pages {
  /// URL path segment, e.g. "about" for /about
  slug      String   @id
  title     String
  /// Markdown (no raw HTML)
  body      String
  /// Has a DB default so rows inserted or edited by hand in SQL work too.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("pages")
}
